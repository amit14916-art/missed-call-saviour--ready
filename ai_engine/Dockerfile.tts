FROM python:3.10-slim

WORKDIR /app

# Install dependencies
RUN apt-get update && apt-get install -y wget curl build-essential xz-utils && rm -rf /var/lib/apt/lists/*

# Download Piper binary (standalone)
RUN wget https://github.com/rhasspy/piper/releases/download/v1.2.0/piper_amd64.tar.gz && \
    tar -xf piper_amd64.tar.gz && \
    rm piper_amd64.tar.gz && \
    mv piper/piper /usr/local/bin/piper && \
    mv piper/*.so* /usr/local/lib/ && \
    ldconfig

# Install python runpod wrapper
RUN pip install runpod

# Download default piper model (Amy)
RUN wget -O model.onnx https://github.com/rhasspy/piper/releases/download/v1.0.0/en_US-amy-medium.onnx
RUN wget -O model.onnx.json https://github.com/rhasspy/piper/releases/download/v1.0.0/en_US-amy-medium.onnx.json

COPY tts_handler.py .
CMD [ "python", "-u", "tts_handler.py" ]
